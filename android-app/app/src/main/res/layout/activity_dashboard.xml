<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:padding="24dp"
    android:background="@color/colorBackground">

    <!-- Header Section -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome Back"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextSecondary"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvHolderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Name"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextPrimary"
        android:layout_marginBottom="24dp" />

    <!-- Balance Card (Premium Box with Shadow) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="20dp"
        android:elevation="6dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Balance"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/tvBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 0.00"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimaryDark"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFE0E0E0"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvAccountNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A/C: "
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary" />
    </LinearLayout>

    <!-- QR Code Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/white"
        android:padding="20dp"
        android:elevation="6dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Receive Money (My UPI QR)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@color/colorBackground"
            android:gravity="center"
            android:layout_marginBottom="12dp">
            
            <!-- Simulated QR representation -->
            <View
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@color/black" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVpa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="vpa@bngl"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary" />
    </LinearLayout>

    <!-- Scan & Pay Action Button -->
    <Button
        android:id="@+id/btnScanToPay"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/scan_to_pay"
        android:textSize="18sp"
        android:backgroundTint="@color/colorAccent"
        android:textColor="@color/white"
        android:elevation="4dp" />

</LinearLayout>
